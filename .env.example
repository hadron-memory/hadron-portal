LOCAL_SERVER_URL=http://localhost:4000
PUBLIC_SERVER_URL=http://localhost:4000

# Portal's own public base URL, used to compose shareable /app/u/<urn> links
# (the "Copy URL" button on URN chips). In production set this to the canonical
# portal origin, e.g. https://hadronmemory.com
PUBLIC_PORTAL_URL=http://localhost:5173

# Official Hadron GitHub App slug (enables 1-click install flow)
# Leave empty to only show the manual/custom app setup
PUBLIC_HADRON_GITHUB_APP_SLUG=
