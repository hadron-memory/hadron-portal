LOCAL_SERVER_URL=http://localhost:4000
PUBLIC_SERVER_URL=http://localhost:4000

# Official Hadron GitHub App slug (enables 1-click install flow)
# Leave empty to only show the manual/custom app setup
PUBLIC_HADRON_GITHUB_APP_SLUG=

# Origin of the object store the browser PUTs asset bytes to (presigned
# upload). Must match hadron-server's ASSET_STORAGE_ENDPOINT origin, or the
# upload dies at the final step with a CSP connect-src violation.
# Prod (Hetzner): https://nbg1.your-objectstorage.com   Local dev: MinIO.
# Read at RUNTIME (#700, src/hooks.server.ts) — changing it needs only a
# restart; when unset, the server logs a loud [csp] error at boot.
PUBLIC_ASSET_STORAGE_ORIGIN=http://localhost:9000
# #1470: Cloudflare Turnstile site key (public by design). Unset: no widget on the email sign-in forms.
PUBLIC_TURNSTILE_SITE_KEY=
